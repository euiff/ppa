from pathlib import Path
import gzip,base64

root=Path('pkg')
asset=next((root/'assets').glob('index-*.js'))
s=asset.read_text(encoding='utf-8')

def rep(old,new,label):
    global s
    c=s.count(old)
    if c!=1:
        raise SystemExit(f'{label} anchor count={c}')
    s=s.replace(old,new,1)

